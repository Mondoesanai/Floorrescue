# Copy to .env.local and fill in as credentials become available.
# The site works fully without any of these — see the fallbacks noted below.

# Resend (https://resend.com) — sends the Request a Quote lead notification
# to vip@floorrescue.com. Without this, submissions are logged to the
# console and saved under .leads/ instead of emailed (see src/lib/email/devFallback.ts).
RESEND_API_KEY=

# Optional "from" address for outgoing lead emails. Defaults to Resend's
# onboarding sender if unset.
LEAD_FROM_EMAIL=

# Anthropic (https://console.anthropic.com) — used only to classify the
# "Other" free-text fields into the approved taxonomy. Without this, a
# deterministic keyword router handles the same job (see src/lib/ai/deterministicRouter.ts).
ANTHROPIC_API_KEY=
